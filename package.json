{
  "name": "freeruler",
  "version": "2.0.9",
  "description": "A free ruler for macOS",
  "main": "none",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "get:version": "node -p \"require('./package.json').version\"",
    "get:commits": "git log --pretty=oneline | wc -l",
    "bump:version": "node scripts/release/bump-version.js",
    "release:version": "node scripts/release/set-version.js",
    "release:github:check": "scripts/release/check-github-release.sh",
    "release:github:archive": "scripts/release/archive-github-release.sh",
    "release:github:export": "scripts/release/export-github-release.sh",
    "release:github:notarize": "scripts/release/notarize-github-release.sh",
    "release:github:zip": "scripts/release/zip-github-release.sh",
    "release:github:publish": "scripts/release/publish-github-release.sh",
    "release:github": "scripts/release/github-release.sh",
    "github:release:dryrun": "RELEASE_DRY_RUN=1 RELEASE_SKIP_NOTARIZE=1 RELEASE_OVERWRITE=1 scripts/release/github-release.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pascalpp/FreeRuler.git"
  },
  "author": "Pascal <pascal@pascal.com>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/pascalpp/FreeRuler/issues"
  },
  "homepage": "https://github.com/pascalpp/FreeRuler#readme"
}
