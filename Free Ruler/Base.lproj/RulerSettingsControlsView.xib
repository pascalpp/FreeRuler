<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="24506" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES" customObjectInstantitationMethod="direct">
    <dependencies>
        <deployment identifier="macosx"/>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="24506"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="RulerSettingsControlsView" customModule="Free_Ruler" customModuleProvider="target">
            <connections>
                <outlet property="backgroundOpacityLabel" destination="RSV-bg-value" id="RSV-bg-value-outlet"/>
                <outlet property="backgroundOpacitySlider" destination="RSV-bg-slider" id="RSV-bg-slider-outlet"/>
                <outlet property="backgroundOpacityTitleLabel" destination="RSV-bg-label" id="RSV-bg-title-outlet"/>
                <outlet property="contentView" destination="RSV-content" id="RSV-content-outlet"/>
                <outlet property="dimensionHeightField" destination="RSV-dimension-height" id="RSV-dimension-height-outlet"/>
                <outlet property="dimensionWidthField" destination="RSV-dimension-width" id="RSV-dimension-width-outlet"/>
                <outlet property="dimensionsLabel" destination="RSV-dimensions-label" id="RSV-dimensions-label-outlet"/>
                <outlet property="dimensionsSeparatorLabel" destination="RSV-dimensions-separator" id="RSV-dimensions-separator-outlet"/>
                <outlet property="floatRulersCheckbox" destination="RSV-float-checkbox" id="RSV-float-outlet"/>
                <outlet property="foregroundOpacityLabel" destination="RSV-fg-value" id="RSV-fg-value-outlet"/>
                <outlet property="foregroundOpacitySlider" destination="RSV-fg-slider" id="RSV-fg-slider-outlet"/>
                <outlet property="foregroundOpacityTitleLabel" destination="RSV-fg-label" id="RSV-fg-title-outlet"/>
                <outlet property="resetRulerColorButton" destination="RSV-reset-button" id="RSV-reset-outlet"/>
                <outlet property="rulerColorLabel" destination="RSV-color-label" id="RSV-color-title-outlet"/>
                <outlet property="rulerColorWell" destination="RSV-color-well" id="RSV-color-outlet"/>
                <outlet property="rulerShadowCheckbox" destination="RSV-shadow-checkbox" id="RSV-shadow-outlet"/>
                <outlet property="unitLabel" destination="RSV-unit-label" id="RSV-unit-label-outlet"/>
                <outlet property="unitSegmentedControl" destination="RSV-unit-control" id="RSV-unit-control-outlet"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <customView id="RSV-content">
            <rect key="frame" x="0.0" y="0.0" width="312" height="320"/>
            <autoresizingMask key="autoresizingMask"/>
            <subviews>
                <textField focusRingType="none" horizontalHuggingPriority="251" verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="RSV-unit-label">
                    <rect key="frame" x="13" y="285" width="29" height="16"/>
                    <textFieldCell key="cell" lineBreakMode="clipping" title="Unit" id="RSV-unit-cell">
                        <font key="font" metaFont="system"/>
                        <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
                <segmentedControl verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="RSV-unit-control">
                    <rect key="frame" x="157" y="279" width="136" height="28"/>
                    <segmentedCell key="cell" borderStyle="border" alignment="left" style="rounded" trackingMode="selectOne" id="RSV-unit-control-cell">
                        <font key="font" metaFont="system"/>
                        <segments>
                            <segment label="px" width="40"/>
                            <segment label="mm" width="40"/>
                            <segment label="in" width="40"/>
                        </segments>
                    </segmentedCell>
                </segmentedControl>
                <textField focusRingType="none" horizontalHuggingPriority="251" verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="RSV-dimensions-label">
                    <rect key="frame" x="13" y="249" width="75" height="16"/>
                    <textFieldCell key="cell" lineBreakMode="clipping" title="Dimensions" id="RSV-dimensions-cell">
                        <font key="font" metaFont="system"/>
                        <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
                <textField focusRingType="none" verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="RSV-dimension-width">
                    <rect key="frame" x="161" y="245" width="56" height="24"/>
                    <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" selectable="YES" editable="YES" borderStyle="bezel" alignment="right" drawsBackground="YES" id="RSV-dimension-width-cell">
                        <font key="font" metaFont="system"/>
                        <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
                <textField focusRingType="none" horizontalHuggingPriority="251" verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="RSV-dimensions-separator">
                    <rect key="frame" x="215" y="249" width="22" height="16"/>
                    <textFieldCell key="cell" lineBreakMode="clipping" alignment="center" title="x" id="RSV-dimensions-separator-cell">
                        <font key="font" metaFont="system"/>
                        <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
                <textField focusRingType="none" verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="RSV-dimension-height">
                    <rect key="frame" x="235" y="245" width="56" height="24"/>
                    <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" selectable="YES" editable="YES" borderStyle="bezel" alignment="right" drawsBackground="YES" id="RSV-dimension-height-cell">
                        <font key="font" metaFont="system"/>
                        <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
                <textField focusRingType="none" horizontalHuggingPriority="251" verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="RSV-color-label">
                    <rect key="frame" x="13" y="213" width="72" height="16"/>
                    <textFieldCell key="cell" lineBreakMode="clipping" title="Ruler Color" id="RSV-color-cell">
                        <font key="font" metaFont="system"/>
                        <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
                <button verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="RSV-reset-button">
                    <rect key="frame" x="200" y="207" width="28" height="28"/>
                    <buttonCell key="cell" type="square" bezelStyle="shadowlessSquare" imagePosition="only" alignment="center" imageScaling="proportionallyDown" id="RSV-reset-cell">
                        <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                        <font key="font" metaFont="system"/>
                    </buttonCell>
                    <color key="bezelColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                </button>
                <colorWell translatesAutoresizingMaskIntoConstraints="NO" id="RSV-color-well" customClass="RulerColorWell" customModule="Free_Ruler" customModuleProvider="target">
                    <rect key="frame" x="228" y="203" width="66" height="36"/>
                    <color key="color" name="systemYellowColor" catalog="System" colorSpace="catalog"/>
                </colorWell>
                <textField focusRingType="none" horizontalHuggingPriority="251" verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="RSV-fg-label">
                    <rect key="frame" x="13" y="171" width="125" height="16"/>
                    <textFieldCell key="cell" lineBreakMode="clipping" title="Foreground Opacity" id="RSV-fg-cell">
                        <font key="font" metaFont="system"/>
                        <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
                <textField focusRingType="none" horizontalHuggingPriority="251" verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="RSV-fg-value">
                    <rect key="frame" x="245" y="171" width="48" height="16"/>
                    <textFieldCell key="cell" lineBreakMode="clipping" alignment="right" title="100%" id="RSV-fg-value-cell">
                        <font key="font" metaFont="system"/>
                        <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
                <slider verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="RSV-fg-slider">
                    <rect key="frame" x="13" y="131" width="280" height="36"/>
                    <sliderCell key="cell" continuous="YES" state="on" alignment="left" minValue="5" maxValue="100" doubleValue="90" tickMarkPosition="below" numberOfTickMarks="20" allowsTickMarkValuesOnly="YES" sliderType="linear" id="RSV-fg-slider-cell"/>
                </slider>
                <textField focusRingType="none" horizontalHuggingPriority="251" verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="RSV-bg-label">
                    <rect key="frame" x="13" y="107" width="127" height="16"/>
                    <textFieldCell key="cell" lineBreakMode="clipping" title="Background Opacity" id="RSV-bg-cell">
                        <font key="font" metaFont="system"/>
                        <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
                <textField focusRingType="none" horizontalHuggingPriority="251" verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="RSV-bg-value">
                    <rect key="frame" x="245" y="107" width="48" height="16"/>
                    <textFieldCell key="cell" lineBreakMode="clipping" alignment="right" title="50%" id="RSV-bg-value-cell">
                        <font key="font" metaFont="system"/>
                        <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
                <slider verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="RSV-bg-slider">
                    <rect key="frame" x="13" y="67" width="280" height="36"/>
                    <sliderCell key="cell" continuous="YES" state="on" alignment="left" minValue="5" maxValue="100" doubleValue="50" tickMarkPosition="below" numberOfTickMarks="20" allowsTickMarkValuesOnly="YES" sliderType="linear" id="RSV-bg-slider-cell"/>
                </slider>
                <button verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="RSV-float-checkbox">
                    <rect key="frame" x="13" y="50" width="278" height="18"/>
                    <buttonCell key="cell" type="check" title="Float rulers above other applications" bezelStyle="regularSquare" imagePosition="left" state="on" inset="2" id="RSV-float-cell">
                        <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                        <font key="font" metaFont="system"/>
                    </buttonCell>
                </button>
                <button verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="RSV-shadow-checkbox">
                    <rect key="frame" x="13" y="24" width="278" height="18"/>
                    <buttonCell key="cell" type="check" title="Show ruler shadow" bezelStyle="regularSquare" imagePosition="left" inset="2" id="RSV-shadow-cell">
                        <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                        <font key="font" metaFont="system"/>
                    </buttonCell>
                </button>
            </subviews>
            <constraints>
                <constraint firstItem="RSV-bg-label" firstAttribute="top" secondItem="RSV-fg-slider" secondAttribute="bottom" constant="14" id="RSV-bg-below-fg-slider"/>
                <constraint firstItem="RSV-bg-label" firstAttribute="trailing" relation="lessThanOrEqual" secondItem="RSV-bg-value" secondAttribute="leading" constant="-8" id="RSV-bg-label-before-value"/>
                <constraint firstItem="RSV-bg-label" firstAttribute="leading" secondItem="RSV-unit-label" secondAttribute="leading" id="RSV-bg-leading"/>
                <constraint firstItem="RSV-bg-slider" firstAttribute="top" secondItem="RSV-bg-label" secondAttribute="bottom" constant="6" id="RSV-bg-slider-below-label"/>
                <constraint firstItem="RSV-bg-slider" firstAttribute="height" constant="28" id="RSV-bg-slider-height"/>
                <constraint firstItem="RSV-bg-slider" firstAttribute="leading" secondItem="RSV-unit-label" secondAttribute="leading" id="RSV-bg-slider-leading"/>
                <constraint firstItem="RSV-bg-slider" firstAttribute="trailing" secondItem="RSV-unit-control" secondAttribute="trailing" id="RSV-bg-slider-trailing"/>
                <constraint firstItem="RSV-bg-value" firstAttribute="centerY" secondItem="RSV-bg-label" secondAttribute="centerY" id="RSV-bg-value-center-y"/>
                <constraint firstItem="RSV-bg-value" firstAttribute="trailing" secondItem="RSV-unit-control" secondAttribute="trailing" id="RSV-bg-value-trailing"/>
                <constraint firstItem="RSV-bg-value" firstAttribute="width" constant="44" id="RSV-bg-value-width"/>
                <constraint firstItem="RSV-color-label" firstAttribute="top" secondItem="RSV-dimensions-label" secondAttribute="bottom" constant="20" id="RSV-color-below-dimensions"/>
                <constraint firstItem="RSV-color-label" firstAttribute="trailing" relation="lessThanOrEqual" secondItem="RSV-reset-button" secondAttribute="leading" constant="-8" id="RSV-color-label-before-reset"/>
                <constraint firstItem="RSV-color-label" firstAttribute="leading" secondItem="RSV-unit-label" secondAttribute="leading" id="RSV-color-leading"/>
                <constraint firstItem="RSV-color-well" firstAttribute="centerY" secondItem="RSV-color-label" secondAttribute="centerY" id="RSV-color-well-center-y"/>
                <constraint firstItem="RSV-color-well" firstAttribute="height" constant="32" id="RSV-color-well-height"/>
                <constraint firstItem="RSV-color-well" firstAttribute="trailing" secondItem="RSV-unit-control" secondAttribute="trailing" id="RSV-color-well-trailing"/>
                <constraint firstItem="RSV-color-well" firstAttribute="width" constant="60" id="RSV-color-well-width"/>
                <constraint firstItem="RSV-dimension-height" firstAttribute="centerY" secondItem="RSV-dimensions-label" secondAttribute="centerY" id="RSV-dimension-height-center-y"/>
                <constraint firstItem="RSV-dimension-height" firstAttribute="height" constant="24" id="RSV-dimension-height-height"/>
                <constraint firstItem="RSV-dimension-height" firstAttribute="trailing" secondItem="RSV-unit-control" secondAttribute="trailing" id="RSV-dimension-height-trailing"/>
                <constraint firstItem="RSV-dimension-height" firstAttribute="width" constant="56" id="RSV-dimension-height-width"/>
                <constraint firstItem="RSV-dimension-width" firstAttribute="centerY" secondItem="RSV-dimensions-label" secondAttribute="centerY" id="RSV-dimension-width-center-y"/>
                <constraint firstItem="RSV-dimension-width" firstAttribute="height" constant="24" id="RSV-dimension-width-height"/>
                <constraint firstItem="RSV-dimension-width" firstAttribute="trailing" secondItem="RSV-dimensions-separator" secondAttribute="leading" id="RSV-dimension-width-trailing"/>
                <constraint firstItem="RSV-dimension-width" firstAttribute="width" constant="56" id="RSV-dimension-width-width"/>
                <constraint firstItem="RSV-dimensions-label" firstAttribute="top" secondItem="RSV-unit-label" secondAttribute="bottom" constant="20" id="RSV-dimensions-below-unit"/>
                <constraint firstItem="RSV-dimensions-label" firstAttribute="trailing" relation="lessThanOrEqual" secondItem="RSV-dimension-width" secondAttribute="leading" constant="-8" id="RSV-dimensions-label-before-width"/>
                <constraint firstItem="RSV-dimensions-label" firstAttribute="leading" secondItem="RSV-unit-label" secondAttribute="leading" id="RSV-dimensions-leading"/>
                <constraint firstItem="RSV-dimensions-separator" firstAttribute="centerY" secondItem="RSV-dimensions-label" secondAttribute="centerY" id="RSV-dimensions-separator-center-y"/>
                <constraint firstItem="RSV-dimensions-separator" firstAttribute="trailing" secondItem="RSV-dimension-height" secondAttribute="leading" id="RSV-dimensions-separator-trailing"/>
                <constraint firstItem="RSV-dimensions-separator" firstAttribute="width" constant="18" id="RSV-dimensions-separator-width"/>
                <constraint firstItem="RSV-fg-label" firstAttribute="top" secondItem="RSV-color-well" secondAttribute="bottom" constant="18" id="RSV-fg-below-color"/>
                <constraint firstItem="RSV-fg-label" firstAttribute="trailing" relation="lessThanOrEqual" secondItem="RSV-fg-value" secondAttribute="leading" constant="-8" id="RSV-fg-label-before-value"/>
                <constraint firstItem="RSV-fg-label" firstAttribute="leading" secondItem="RSV-unit-label" secondAttribute="leading" id="RSV-fg-leading"/>
                <constraint firstItem="RSV-fg-slider" firstAttribute="top" secondItem="RSV-fg-label" secondAttribute="bottom" constant="6" id="RSV-fg-slider-below-label"/>
                <constraint firstItem="RSV-fg-slider" firstAttribute="height" constant="28" id="RSV-fg-slider-height"/>
                <constraint firstItem="RSV-fg-slider" firstAttribute="leading" secondItem="RSV-unit-label" secondAttribute="leading" id="RSV-fg-slider-leading"/>
                <constraint firstItem="RSV-fg-slider" firstAttribute="trailing" secondItem="RSV-unit-control" secondAttribute="trailing" id="RSV-fg-slider-trailing"/>
                <constraint firstItem="RSV-fg-value" firstAttribute="centerY" secondItem="RSV-fg-label" secondAttribute="centerY" id="RSV-fg-value-center-y"/>
                <constraint firstItem="RSV-fg-value" firstAttribute="trailing" secondItem="RSV-unit-control" secondAttribute="trailing" id="RSV-fg-value-trailing"/>
                <constraint firstItem="RSV-fg-value" firstAttribute="width" constant="44" id="RSV-fg-value-width"/>
                <constraint firstItem="RSV-float-checkbox" firstAttribute="top" secondItem="RSV-bg-slider" secondAttribute="bottom" constant="6" id="RSV-float-below-bg-slider"/>
                <constraint firstItem="RSV-float-checkbox" firstAttribute="leading" secondItem="RSV-unit-label" secondAttribute="leading" id="RSV-float-leading"/>
                <constraint firstItem="RSV-float-checkbox" firstAttribute="trailing" secondItem="RSV-unit-control" secondAttribute="trailing" id="RSV-float-trailing"/>
                <constraint firstItem="RSV-reset-button" firstAttribute="trailing" secondItem="RSV-color-well" secondAttribute="leading" constant="-3" id="RSV-reset-before-color"/>
                <constraint firstItem="RSV-reset-button" firstAttribute="centerY" secondItem="RSV-color-well" secondAttribute="centerY" id="RSV-reset-center-y"/>
                <constraint firstItem="RSV-reset-button" firstAttribute="height" constant="28" id="RSV-reset-height"/>
                <constraint firstItem="RSV-reset-button" firstAttribute="width" constant="28" id="RSV-reset-width"/>
                <constraint firstItem="RSV-shadow-checkbox" firstAttribute="top" secondItem="RSV-float-checkbox" secondAttribute="bottom" constant="10" id="RSV-shadow-below-float"/>
                <constraint firstItem="RSV-shadow-checkbox" firstAttribute="leading" secondItem="RSV-unit-label" secondAttribute="leading" id="RSV-shadow-leading"/>
                <constraint firstItem="RSV-shadow-checkbox" firstAttribute="trailing" secondItem="RSV-unit-control" secondAttribute="trailing" id="RSV-shadow-trailing"/>
                <constraint firstItem="RSV-unit-control" firstAttribute="centerY" secondItem="RSV-unit-label" secondAttribute="centerY" id="RSV-unit-control-center-y"/>
                <constraint firstItem="RSV-unit-control" firstAttribute="height" constant="26" id="RSV-unit-control-height"/>
                <constraint firstItem="RSV-unit-control" firstAttribute="trailing" secondItem="RSV-content" secondAttribute="trailing" constant="-21" id="RSV-unit-control-trailing"/>
                <constraint firstItem="RSV-unit-control" firstAttribute="width" constant="132" id="RSV-unit-control-width"/>
                <constraint firstItem="RSV-unit-label" firstAttribute="trailing" relation="lessThanOrEqual" secondItem="RSV-unit-control" secondAttribute="leading" constant="-8" id="RSV-unit-label-before-control"/>
                <constraint firstItem="RSV-unit-label" firstAttribute="leading" secondItem="RSV-content" secondAttribute="leading" constant="15" id="RSV-unit-leading"/>
                <constraint firstItem="RSV-unit-label" firstAttribute="top" secondItem="RSV-content" secondAttribute="top" constant="19" id="RSV-unit-top"/>
            </constraints>
            <point key="canvasLocation" x="141" y="244.5"/>
        </customView>
    </objects>
</document>
